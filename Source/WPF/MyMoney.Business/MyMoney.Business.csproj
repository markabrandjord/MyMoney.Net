<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>Walkabout</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Needed by Taxes\FederalTaxes.cs and Taxes\StateTaxes.cs (JsonProperty/JsonConvert),
         moved here in Task 3. Version matches MyMoney.csproj's existing reference. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Needed by Utilities\Logger.cs (LogLevel only), moved here in Task 8.
         Version matches MyMoney.csproj's existing reference. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!--
      PublicResXFileCodeGenerator (not the default ResXFileCodeGenerator) so
      that Resources.Designer.cs's class and string properties come out
      public, not internal - ~56 call sites across MyMoney.csproj need them
      once Task 4 wires the ProjectReference. Resources.Designer.cs itself
      was hand-edited to match (this environment can't trigger a real
      regeneration); if it's ever regenerated for real (e.g. from Visual
      Studio), this Generator value is what keeps that regeneration public
      instead of silently reverting to internal.
    -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Taxes\StateTaxes.json" />
    <Content Include="Taxes\FederalTaxes.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Taxes\StateTaxes.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Taxes\TxfSpec.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Moved here in Task 5 along with StockQuotes\*.cs. -->
    <None Include="StockQuotes\Design.dgml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Moved here in Task 8 along with Ofx\*.cs. RootNamespace is Walkabout here
      too, so every "Walkabout.Ofx.*" manifest name is unchanged - but the
      assembly holding them is not. Ofx.cs (the two DTDs) and
      OfxInstitutionInfo.cs (OfxProviderList.xml) already looked these up via
      typeof(OfxRequest).Assembly and moved with them, so they kept working; the
      two readers left behind in MyMoney.csproj said
      Assembly.GetExecutingAssembly() and had to be repointed the same way -
      MfaChallengeDialog.cs (MfaPhrases.xml) and OfxDownloadController.cs
      (OfxErrorTemplate.htm).
    -->
    <EmbeddedResource Include="Ofx\ofx160.dtd" />
    <EmbeddedResource Include="Ofx\ofx201.dtd" />
    <EmbeddedResource Include="Ofx\MfaPhrases.xml" />
    <EmbeddedResource Include="Ofx\OfxProviderList.xml" />
    <EmbeddedResource Include="Ofx\OfxErrorTemplate.htm" />
    <None Include="Ofx\OFX 2.1.1.pdf" />
    <None Include="Ofx\ofx16.pdf" />
  </ItemGroup>

</Project>
