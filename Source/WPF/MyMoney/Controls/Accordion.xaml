<UserControl
             x:Class="Walkabout.Controls.Accordion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
			 >

    <!--
      WPF-UI's implicit Expander style (App.xaml's ui:ControlsDictionary) sets
      VerticalAlignment="Center" with OverridesDefaultStyle="True" - a centered element can never
      fill a star-sized Grid row, which is exactly what this Accordion's SetRowHeight (Accordion.xaml.cs)
      depends on for the expanded section to fill the remaining space. No animation-timing fix can
      solve that; it's a structural incompatibility, not a race (confirmed via a WPF-UI/lepoco expert
      panel review, 2026-09-20, backed by live FlaUI-driven reproduction screenshots). WPF-UI's own
      Storyboard-driven content reveal (~200-333ms) is a second, additive bug: this app's own
      OnExpanderExpanded/OnExpanderCollapsed resize the outer row synchronously, well before that
      animation resolves, leaving a stale oversized blank area for 1-2+ seconds after each collapse.
      A NavigationView-based rewrite was also evaluated (a second expert panel, same review) as
      Fluent's more idiomatic pattern for primary nav - correct as a long-term direction, but
      NavigationView is a Frame/Page-based control that doesn't cleanly host this Accordion's
      long-lived pre-built UserControls with their own live per-section widgets (QuickFilterControl,
      the IContainerStatus status text), so it's tracked as a separate follow-up rather than attempted
      here. This scoped style override fixes both structural issues, applies only within this
      control (Expanders elsewhere in the app keep WPF-UI's Fluent look/animation), and keeps WPF-UI's
      chevron-rotation animation (RenderTransform only, no layout, can't race SetRowHeight) and theme
      brushes.
    -->
    <UserControl.Resources>
        <Style TargetType="{x:Type Expander}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ExpanderHeaderForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ExpanderHeaderBorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Flat header: bottom separator only, no card chrome -->
                            <Border x:Name="HeaderBorder" Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <ToggleButton x:Name="ExpanderToggleButton"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding Header}"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              OverridesDefaultStyle="True"
                                              Template="{StaticResource DefaultExpanderToggleButtonStyle}"/>
                            </Border>
                            <ContentPresenter x:Name="ContentPresenter" Grid.Row="1"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Instant, no Storyboard: layout resolves in the same pass as SetRowHeight -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger SourceName="ExpanderToggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource ExpanderHeaderBorderPointerOverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
    </Grid>

</UserControl>