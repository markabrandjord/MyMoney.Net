<!-- Source/WPF/MyMoney.Shell/Views/AccountsView.xaml -->
<UserControl x:Class="MyMoney.Shell.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.AutomationId="AccountsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button x:Name="AddAccountButton" AutomationProperties.AutomationId="AddAccountButton"
                       Content="+ Add Account" Appearance="Primary"
                       Margin="0,0,8,0" Click="AddAccountButton_Click"/>
            <ui:Button x:Name="EditAccountButton" AutomationProperties.AutomationId="EditAccountButton"
                       Content="Edit Account" IsEnabled="False"
                       Margin="0,0,8,0" Click="EditAccountButton_Click"/>
            <ui:Button x:Name="DeleteAccountButton" AutomationProperties.AutomationId="DeleteAccountButton"
                       Content="Delete Account" IsEnabled="False"
                       Click="DeleteAccountButton_Click"/>
        </StackPanel>
        <ListView x:Name="AccountsListView" AutomationProperties.AutomationId="AccountsListView"
                  Grid.Row="1" ItemsSource="{Binding Accounts}"
                  SelectionChanged="AccountsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="140"/>
                    <GridViewColumn Header="Currency" DisplayMemberBinding="{Binding Currency}" Width="100"/>
                    <GridViewColumn Header="Opening Balance" DisplayMemberBinding="{Binding OpeningBalance, StringFormat=C}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
